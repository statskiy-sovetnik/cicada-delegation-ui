# Те же переменные, что читает контейнер: в разработке они вшиваются в сборку
# из этого файла, в образе — подставляются при запуске (docker/entrypoint.sh).

# Ключ Alchemy — тело URL подставляется в src/config.ts.
ALCHEMY_API_KEY=

# WalletConnect: нужен RainbowKit.
WALLETCONNECT_PROJECT_ID=

# Executor: откуда брать каталог и куда слать подпись.
EXECUTOR_URL=http://localhost:8787

# Делегатор, чью позицию обслуживает интерфейс. Кнопки, меняющие состояние,
# доступны только когда подключён именно этот адрес.
DELEGATOR_ADDRESS=0xef641191A9ae8aEB9196A253B3B428Ac7F2898D2
